{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "FUNCTIONS_DISCOVERY_TIMEOUT=90 firebase emulators:start --only functions",
    "shell": "FUNCTIONS_DISCOVERY_TIMEOUT=90 firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1"
  },
  "private": true
}
