rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function approved() {
      return request.auth != null
        && request.auth.token.studentNumber is string
        && request.auth.uid == 'caremate-' + request.auth.token.studentNumber
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.active == true;
    }

    function admin() {
      return approved()
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.role == 'admin';
    }

    function owner(studentNumber) {
      return approved() && request.auth.token.studentNumber == studentNumber;
    }

    function assignmentEnabled() {
      return approved()
        && (
          !('experienceMode' in get(/databases/$(database)/documents/access/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/access/$(request.auth.uid)).data.experienceMode == 'assignments'
        );
    }

    function permittedStudent(studentNumber) {
      let uid = 'caremate-' + studentNumber;
      return exists(/databases/$(database)/documents/access/$(uid))
        && get(/databases/$(database)/documents/access/$(uid)).data.active == true;
    }

    // Only the Admin SDK may issue or revoke access. A user may inspect their
    // own current role; admins may inspect the three configured entries.
    match /access/{uid} {
      allow get: if approved() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }

    match /users/{studentNumber} {
      // Admin lists use a sanitized callable; never expose another user's
      // entire document (which still contains legacy credential fields).
      allow get: if owner(studentNumber);
      allow list: if false;
      allow create, delete: if false;
      allow update: if owner(studentNumber)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'notificationSettings', 'lastLoginAt', 'lastActiveAt'
        ]);

      match /pushSubscriptions/{deviceId} {
        allow read, create, update, delete: if owner(studentNumber);
      }
      match /examProgress/{id} {
        allow read, create, update: if owner(studentNumber);
        allow delete: if false;
      }
      match /solvedQuestions/{id} {
        allow read, create, update: if owner(studentNumber);
        allow delete: if false;
      }
      match /studySessions/{id} {
        allow read, create, update, delete: if owner(studentNumber);
      }
      match /studyState/{id} {
        allow read, create, update, delete: if owner(studentNumber);
      }
      match /questionAttempts/{id} {
        allow read, create: if owner(studentNumber);
        allow update, delete: if false;
      }
      match /studyGoals/{id} {
        allow read, create, update, delete: if owner(studentNumber);
      }
      match /enrolledSubjects/{id} {
        allow read: if owner(studentNumber);
        allow write: if false;
      }
      // Retained read-only for existing test progress displays.
      match /subjectPoints/{id} {
        allow read: if owner(studentNumber);
        allow write: if false;
      }
      match /subjectPointHistory/{id} {
        allow read: if owner(studentNumber);
        allow write: if false;
      }
    }

    match /publicUsers/{studentNumber} {
      allow get: if owner(studentNumber) || (admin() && permittedStudent(studentNumber));
      allow list: if false;
      allow write: if false;
    }

    match /assignments/{studentNumber} {
      allow get: if (owner(studentNumber) && assignmentEnabled()) || (admin() && permittedStudent(studentNumber));
      allow list: if false;
      allow write: if false;
    }

    match /calendarAssignments/{studentNumber}/items/{id} {
      allow get, list: if owner(studentNumber) && assignmentEnabled();
      allow write: if false;
    }

    match /calendarPersonal/{studentNumber}/items/{id} {
      allow get, list: if owner(studentNumber);
      allow create: if owner(studentNumber)
        && request.resource.data.keys().hasOnly(['title', 'date', 'time', 'note', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 5
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if owner(studentNumber)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'date', 'time', 'note', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 5
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updatedAt is timestamp;
      allow delete: if owner(studentNumber);
    }

    match /system/exam {
      allow read: if approved();
      allow write: if admin();
    }

    match /examSubjects/{subjectId} {
      allow read: if approved();
      allow write: if admin();

      match /units/{unitId} {
        allow read: if approved();
        allow write: if admin();

        match /publishedQuestions/{id} {
          allow read: if approved();
          allow write: if admin();
        }
        match /ai/{id} {
          allow read, write: if admin();
        }
        match /materials/{id} {
          allow read, write: if admin();
        }
        match /features/{id} {
          allow read: if approved();
          allow write: if admin();
        }
      }
    }

    match /{path=**}/publishedQuestions/{id} {
      allow read: if approved();
      allow write: if false;
    }

    match /reports/{id} {
      allow create: if approved()
        && request.resource.data.reporterStudentNumber == request.auth.token.studentNumber;
      allow get: if admin() || (approved()
        && resource.data.reporterStudentNumber == request.auth.token.studentNumber);
      allow list, update, delete: if admin();
    }

    // CareMate Test is a separate, email-verified study app. Its data is kept
    // under the studyApp* namespace and does not share users or questions with
    // the existing CareMate application above.
    function studyStudentEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@\\s]+@sums\\.ac\\.jp$');
    }

    function studyAdminEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[0-9]{7}@admin\\.caremateuniv\\.app$');
    }

    function studyIdentity() {
      return studyStudentEmail() || studyAdminEmail();
    }

    function studyUser() {
      return studyIdentity()
        && exists(/databases/$(database)/documents/studyAppUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/studyAppUsers/$(request.auth.uid)).data.active == true
        && (
          get(/databases/$(database)/documents/studyAppUsers/$(request.auth.uid)).data.role == 'admin'
          || (studyStudentEmail() && request.auth.token.email_verified == true)
        );
    }

    function studyAdmin() {
      return studyUser()
        && get(/databases/$(database)/documents/studyAppUsers/$(request.auth.uid)).data.role == 'admin';
    }

    function studyPrimaryAdmin() {
      return studyAdmin()
        && get(/databases/$(database)/documents/studyAppUsers/$(request.auth.uid)).data.studentNumber == '2510044';
    }

    function validStudyAdminInvite(code) {
      let invite = get(/databases/$(database)/documents/studyAppInvites/$(code)).data;
      return exists(/databases/$(database)/documents/studyAppInvites/$(code))
        && invite.active == true
        && invite.studentNumber == request.resource.data.studentNumber
        && invite.role == 'admin';
    }

    match /studyAppUsers/{uid} {
      allow get: if studyIdentity() && (request.auth.uid == uid || studyAdmin());
      allow list: if studyAdmin();
      allow create: if studyIdentity()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'studentNumber', 'name', 'email', 'role', 'active', 'inviteCode',
          'emailVerified', 'createdAt', 'verifiedAt'
        ])
        && request.resource.data.studentNumber is string
        && request.resource.data.studentNumber.matches('^[0-9]{7}$')
        && request.resource.data.role in ['student', 'admin']
        && request.resource.data.active == true
        && getAfter(/databases/$(database)/documents/studyAppStudentNumbers/$(request.resource.data.studentNumber)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/studyAppStudentNumbers/$(request.resource.data.studentNumber)).data.deleted == false
        && (
          (request.resource.data.role == 'student'
            && studyStudentEmail()
            && request.auth.token.email_verified == true
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.emailVerified == true
            && !('inviteCode' in request.resource.data))
          ||
          (request.resource.data.role == 'admin'
            && studyAdminEmail()
            && !('email' in request.resource.data)
            && !('emailVerified' in request.resource.data)
            && request.resource.data.inviteCode is string
            && validStudyAdminInvite(request.resource.data.inviteCode))
        );
      allow update: if studyAdmin()
        && resource.data.studentNumber != '2510044'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.studentNumber == resource.data.studentNumber;
      allow delete: if studyPrimaryAdmin() && resource.data.studentNumber != '2510044';

      match /progress/{progressId} {
        allow read: if (studyUser() && request.auth.uid == uid) || studyPrimaryAdmin();
        allow create, update: if studyUser() && request.auth.uid == uid;
        allow delete: if studyPrimaryAdmin();
      }
    }

    match /studyAppStudentNumbers/{studentNumber} {
      allow get, list: if studyAdmin();
      allow create: if (
          request.auth != null
          && studyIdentity()
          && request.resource.data.keys().hasOnly(['uid', 'studentNumber', 'deleted', 'createdAt', 'deletedAt'])
          && request.resource.data.studentNumber == studentNumber
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.deleted == false
          && getAfter(/databases/$(database)/documents/studyAppUsers/$(request.auth.uid)).data.studentNumber == studentNumber
        ) || (
          studyPrimaryAdmin()
          && request.resource.data.uid is string
          && request.resource.data.studentNumber == studentNumber
          && request.resource.data.deleted == true
          && exists(/databases/$(database)/documents/studyAppUsers/$(request.resource.data.uid))
          && get(/databases/$(database)/documents/studyAppUsers/$(request.resource.data.uid)).data.studentNumber == studentNumber
        );
      allow update: if studyPrimaryAdmin()
        && resource.data.uid == request.resource.data.uid
        && resource.data.studentNumber == request.resource.data.studentNumber
        && request.resource.data.deleted == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt']);
      allow delete: if false;
    }

    match /studyAppInvites/{code} {
      // The code is high entropy and can only be checked after Firebase Auth has
      // created the short-lived internal administrator identity.
      allow get: if studyIdentity();
      allow list: if studyAdmin();
      allow create: if studyAdmin()
        && request.resource.data.keys().hasOnly([
          'studentNumber', 'name', 'role', 'active', 'bootstrap', 'createdAt'
        ])
        && request.resource.data.studentNumber is string
        && request.resource.data.studentNumber.matches('^[0-9]{7}$')
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && request.resource.data.bootstrap == false;
      allow update: if false;
      allow delete: if studyAdmin()
        || (studyAdminEmail()
          && existsAfter(/databases/$(database)/documents/studyAppUsers/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/studyAppUsers/$(request.auth.uid)).data.inviteCode == code);
    }

    match /studyAppCategories/{categoryId} {
      allow read: if studyUser();
      allow create, update, delete: if studyAdmin();
    }

    match /studyAppSubjects/{subjectId} {
      allow read: if studyAdmin() || (studyUser() && resource.data.published == true);
      allow create, update, delete: if studyAdmin();

      match /units/{unitId} {
        allow read: if studyAdmin() || (studyUser() && resource.data.published == true);
        allow create, update, delete: if studyAdmin();
      }
    }

    match /studyAppReports/{reportId} {
      allow create: if studyUser()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow get: if studyAdmin()
        || (studyUser() && resource.data.reporterUid == request.auth.uid);
      allow list, update, delete: if studyAdmin();
    }

    // Old CareMate collections, private configuration and user-registration
    // paths have no client access. Existing documents are not deleted.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
