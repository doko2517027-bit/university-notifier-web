rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* ========================================
       ユーザー情報
    ======================================== */

    match /users/{userId} {

      allow create, read, delete: if true;

      /*
       attendanceNotificationTest はこのユーザードキュメント内に保存する。
       指定学生の履修済み科目だけを用いるテスト通知設定として使う。
      */
      allow update: if true;


      /* 解答済み問題 */

      match /solvedQuestions/{id} {

        allow read, create, update: if true;
        allow delete: if false;

      }


      /* Push通知購読情報 */

      match /pushSubscriptions/{id} {

        allow read, create, update, delete: if true;

      }


      /* 履修登録科目 */

      match /enrolledSubjects/{id} {

        allow read, create, update, delete: if true;

      }


      /* 履修登録履歴 */

      match /enrollmentHistory/{id} {

        allow read, create: if true;
        allow update, delete: if false;

      }


      /* 試験問題進捗 */

      match /examProgress/{id} {

        allow read, create, update: if true;
        allow delete: if false;

      }


      /* 科目別ポイント */

      match /subjectPoints/{id} {

        allow read, create, update: if true;
        allow delete: if false;

      }


      /* 科目別ポイントの日別履歴 */

      match /subjectPointHistory/{id} {

        allow read, create, update: if true;
        allow delete: if false;

      }


      /* 学生ごとの取得単位記録 */

      match /creditRecords/{id} {

        allow read, create, update: if true;
        allow delete: if false;

      }


      /*
       過去に履修した科目の修得・未修得記録。
       本人、または管理者のFirebase認証済み端末だけが扱える。
      */

      match /courseHistoryRecords/{id} {

        allow read, create, update, delete: if
          request.auth != null &&
          (
            request.auth.token.studentNumber == userId ||
            request.auth.token.admin == true
          );

      }


      /*
       CareMate内の個人用出席記録。
       大学の公式出席記録ではない。
      */

      match /attendanceRecords/{recordId} {

        /*
         出席・欠席・遅刻・早退と、管理者確認待ちの記録。
         管理画面はこのルールで確認待ち一覧を読み取り、
         確定結果を書き戻す。
        */

        allow read, create, update: if true;
        allow delete: if false;

      }


      /*
       A・Bクラスなどの通知対象クラスを
       科目名とは別に保存する。
      */

      match /attendancePreferences/{subjectId} {

        allow read, create, update: if true;
        allow delete: if false;

      }


      /* お知らせ既読情報 */

      match /readNews/{readId} {

        allow read: if true;

        allow create: if
          request.resource.data.keys().hasOnly([
            'type',
            'newsId',
            'readAt',
            'studentNumber'
          ])
          && request.resource.data.studentNumber == userId
          && request.resource.data.type in [
            'university',
            'course',
            'system'
          ]
          && request.resource.data.newsId is string
          && request.resource.data.readAt is timestamp;

        allow update, delete: if false;

      }

      match /targetedSystemNews/{newsId} {
        allow read: if request.auth != null && request.auth.token.studentNumber == userId;
        allow write: if false;
      }

    }


    /* ========================================
       開発者・管理者
    ======================================== */

    match /developers/{id} {

      allow read: if true;
      allow write: if false;

    }


    match /admins/{id} {

      allow read: if true;
      allow write: if false;

    }


    /* ========================================
       ログイン端末・IP推定地域
       Webクライアントからの直接アクセスは禁止し、
       2510044を照合するCloud Functionsだけが管理する。
    ======================================== */

    match /userDeviceSessions/{userId} {

      allow read, write: if false;

      match /loginDevices/{deviceId} {

        allow read, write: if false;

      }

    }


    /*
       強制ログアウト通知にはIP・地域・機種を含めない。
       認証済み本人は自分宛ての単一ドキュメントだけ取得でき、
       書き込みと一覧取得はCloud Functionsに限定する。
    */

    match /userDeviceAccess/{userId} {

      allow get: if
        request.auth != null &&
        request.auth.uid == 'caremate-' + userId &&
        request.auth.token.studentNumber == userId;
      allow list, create, update, delete: if false;

      match /logoutRequests/{deviceId} {

        allow get: if
          request.auth != null &&
          request.auth.uid == 'caremate-' + userId &&
          request.auth.token.studentNumber == userId;
        allow list, create, update, delete: if false;

      }

    }


    match /ipGeolocationCache/{cacheId} {

      allow read, write: if false;

    }


    /* ========================================
       公開ユーザー情報
    ======================================== */

    match /publicUsers/{id} {

      allow read, create, delete: if true;

      allow update: if
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'photo'
          ]);

    }


    /* ========================================
       今日の問題
    ======================================== */

    match /today/{id} {

      allow read: if true;
      allow write: if false;

    }


    /* ========================================
       課題
    ======================================== */

    match /assignments/{id} {

      allow read, delete: if true;
      allow write: if false;

    }


    /* ========================================
       Manabaコースリンク
    ======================================== */

    match /courseLinks/{id} {

      allow read: if true;
      allow write: if false;

    }


    /* ========================================
       大学お知らせ
    ======================================== */

    match /news/{id} {

      allow read: if true;
      allow write: if false;

    }


    /* ========================================
       コースお知らせ
    ======================================== */

    match /courseNews/{id} {

      allow read: if true;
      allow write: if false;

    }


    match /courseNews/{studentNumber}/news/{id} {

      allow read: if true;
      allow write: if false;

    }


    /* ========================================
       講義予定
    ======================================== */

    match /schedule/{id} {

      allow read: if true;
      allow write: if false;

    }


    match /scheduleOverrides/{id} {

      allow read, create, update, delete: if true;

    }


    /* ========================================
       出席通知
    ======================================== */

    /*
     通知の重複防止台帳は
     Cloud Functionsのみが操作する。
    */

    match /attendanceNotificationDispatches/{id} {

      allow read, write: if false;

    }


    match /attendance/{studentNumber}/subjects/{subject}/records/{recordId} {

      allow read, create, update: if true;
      allow delete: if false;

    }


    /* ========================================
       システム設定
    ======================================== */

    match /system/app {

      allow read, write: if true;

    }


    match /system/exam {

      allow read, write: if true;

    }


    match /system/courseRegistration {

      allow read, write: if true;

    }


    match /system/courseRegistrationDraft {

      allow read, write: if true;

    }


    /*
     上で個別に許可していない
     systemドキュメントは拒否する。
    */

    match /system/{id} {

      allow read, write: if false;

    }


    /* ========================================
       試験科目・教材・AI問題
    ======================================== */

    match /examSubjects/{subjectId} {

      allow read, write: if true;


      match /units/{unitId} {

        allow read, write: if true;


        match /materials/{id} {

          allow read, write: if true;

        }


        match /ai/{id} {

          allow read, write: if true;

        }


        match /publishedQuestions/{id} {

          allow read, write: if true;

        }


        match /features/{id} {

          allow read, write: if true;

        }

      }

    }


    /* ========================================
       問題報告
    ======================================== */

    match /reports/{id} {

      allow read, create, update, delete: if true;

    }


    /* ========================================
       デイリーランキング
    ======================================== */

    match /dailyRanking/{date} {

      allow read: if true;


      match /users/{id} {

        allow read, create, update: if true;
        allow delete: if false;

      }

    }


    /* ========================================
       ランキング
    ======================================== */

    match /ranking/{id} {

      allow read, create, update: if true;
      allow delete: if false;

    }


    match /totalRanking/{id} {

      allow read, create, update: if true;
      allow delete: if false;

    }


    /* ========================================
       システムお知らせ
    ======================================== */

    match /systemNews/{id} {

      allow read: if true;
      allow create, update, delete: if
        request.auth != null &&
        request.auth.token.admin == true;

    }

    match /targetedSystemNews/{id} {
      allow read, create, update, delete: if request.auth != null && request.auth.token.studentNumber == "2510044";
    }


    /* ========================================
       履修科目マスター
    ======================================== */

    match /subjects/{id} {

      allow read, create, update, delete: if true;

    }
    
    /* ========================================
       開講授業
    ======================================== */

    match /courseOfferings/{id} {

      allow read, create, update, delete: if true;

    }
    
    /* ========================================
       日別クラス分け
    ======================================== */

    match /classAssignments/{id} {

      allow read, create, update, delete: if true;

    }


    /* ========================================
       カリキュラム・卒業要件
    ======================================== */

    match /curricula/{curriculumId} {

      allow read, create, update, delete: if true;

    }


    /* ========================================
       トップレベルの科目ポイント履歴
    ======================================== */

    match /subjectPointHistory/{id} {

      allow read, create, update: if true;
      allow delete: if false;

    }


    /* ========================================
       問い合わせ
    ======================================== */

    match /contacts/{id} {
      // 枠数と累計ポイントをCloud Functions側で検証して作成する。
      allow create: if false;
      allow read: if request.auth != null
        && (resource.data.studentNumber == request.auth.token.studentNumber
          || request.auth.token.studentNumber == "2510044");
      allow update: if request.auth != null
        && (request.auth.token.studentNumber == "2510044"
          || (resource.data.studentNumber == request.auth.token.studentNumber
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "lastMessageAt"])));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/contacts/$(id)).data.studentNumber == request.auth.token.studentNumber
            || request.auth.token.studentNumber == "2510044");
        allow create: if request.auth != null
          && (get(/databases/$(database)/documents/contacts/$(id)).data.studentNumber == request.auth.token.studentNumber
            || request.auth.token.studentNumber == "2510044");
        allow update, delete: if false;
      }

    }


    /* ========================================
       学生専用の機能リクエスト
       一般学生は自分の分だけ、2510044だけが全件を管理する。
    ======================================== */

    match /featureRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.studentNumber == request.auth.token.studentNumber;
      allow read: if request.auth != null
        && (resource.data.studentNumber == request.auth.token.studentNumber
          || request.auth.token.studentNumber == "2510044");
      allow update: if request.auth != null
        && request.auth.token.studentNumber == "2510044";
      allow delete: if false;
    }

    /* ========================================
       対象ユーザー専用 AIデジタルノート
       各学生は自分のノートと問題だけを利用できる。
    ======================================== */
    match /digitalNotes/{studentId}/notes/{noteId} {
      allow read, create, update, delete: if request.auth != null
        && (request.auth.token.studentNumber == "2510044"
          || request.auth.token.studentNumber == "2510054")
        && studentId == request.auth.token.studentNumber;

      match /questions/{questionId} {
        allow read, create, update, delete: if request.auth != null
          && (request.auth.token.studentNumber == "2510044"
            || request.auth.token.studentNumber == "2510054")
          && studentId == request.auth.token.studentNumber;
      }
    }

  }

}
